{
  "name": "knightfall",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,magenta \"npm:dev -w @knightfall/web\" \"npm:dev -w @knightfall/server\"",
    "build": "npm run build -w @knightfall/web && npm run build -w @knightfall/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "puzzles": "node scripts/build-puzzles.mjs",
    "engine": "node scripts/fetch-engine.mjs",
    "engine:deep": "node scripts/fetch-engine.mjs --deep",
    "openings": "node scripts/build-openings.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.5",
    "@types/node": "^24.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
